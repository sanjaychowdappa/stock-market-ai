# Copy to .env and fill in your own values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# Get keys from https://app.alpaca.markets  →  Paper Trading  →  API Keys.
# Use PAPER keys. This project trades on paper only; live keys are unnecessary
# and would put real money behind an unproven strategy.

APCA_API_KEY_ID=<your-paper-key-id>
APCA_API_SECRET_KEY=<your-paper-secret-key>
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_URL=https://data.alpaca.markets
